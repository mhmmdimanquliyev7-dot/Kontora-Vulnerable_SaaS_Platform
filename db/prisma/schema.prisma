// Kontora — Prisma schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  // Lets the generated client's own internal imports (and our seed script,
  // which runs via Node's native TS support rather than tsc) resolve
  // directly without a compile step. tsc still compiles this fine when
  // building the db package for the api's production image.
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Role is per-membership, not on User. A person can belong to more than one
// Company (e.g. an accountant who contracts for two clients), and their
// permissions must never leak from one tenant into another — so the role
// lives on TeamMembership, scoped to a single (userId, companyId) pair.
enum Role {
  OWNER
  ACCOUNTANT
  MEMBER
  CLIENT_GUEST
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  website   String?
  address   String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  TeamMembership[]
  clients      Client[]
  invoices     Invoice[]
  expenses     Expense[]
  sessions     Session[]
  activityLogs ActivityLog[]
  webhooks     Webhook[]

  @@map("companies")
}

// A person's global identity. Holds credentials only — no role, no company
// reference. All tenant-scoped permissions live on TeamMembership.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships         TeamMembership[]
  sessions            Session[]
  createdInvoices     Invoice[]           @relation("InvoiceCreatedBy")
  createdExpenses     Expense[]           @relation("ExpenseCreatedBy")
  activityLogs        ActivityLog[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// Links a User to a Company with a role scoped to that company.
// When role = CLIENT_GUEST, clientId identifies the single Client record
// this guest is allowed to see (enforced in the service layer, not just here).
model TeamMembership {
  id        String   @id @default(uuid())
  role      Role
  userId    String
  companyId String
  clientId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([clientId])
  @@map("team_memberships")
}

// A Company's customer — who invoices are billed to. Distinct from the
// CLIENT_GUEST *User* who may be granted portal access to view them.
model Client {
  id             String   @id @default(uuid())
  companyId      String
  name           String
  email          String?
  phone          String?
  billingAddress String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  guestMembers TeamMembership[]

  @@index([companyId])
  @@map("clients")
}

model Invoice {
  id          String        @id @default(uuid())
  companyId   String
  clientId    String
  createdById String?
  number      String
  status      InvoiceStatus @default(DRAFT)
  issueDate   DateTime
  dueDate     DateTime
  currency    String        @default("USD")
  subtotal    Decimal       @db.Decimal(12, 2)
  tax         Decimal       @db.Decimal(12, 2) @default(0)
  total       Decimal       @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: a client record is disposable, invoice/revenue
  // history is not — deleting a client must not silently delete invoices.
  client    Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     InvoiceItem[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([clientId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(12, 2) @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  position    Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Expense {
  id          String   @id @default(uuid())
  companyId   String
  createdById String?
  category    String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@map("expenses")
}

// One row per refresh token = one logged-in session, scoped to a single
// company context. Access tokens are short-lived JWTs derived from a
// Session and are never stored server-side.
model Session {
  id               String    @id @default(uuid())
  userId           String
  companyId        String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// One row per issued "forgot password" link. Only the SHA-256 hash of the
// token is stored (same rationale as Session.refreshTokenHash) — a leaked
// database dump can't be used to reset anyone's password. usedAt makes the
// token single-use even though it's also time-limited; a raw token only
// ever exists in the emailed link and briefly in server memory.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// A company-configured HTTP callback, called when one of `events` happens
// to one of their own records (see webhook.service.ts's dispatchEvent).
// `secret` signs every delivery (HMAC-SHA256 over the raw body, same idea
// as Stripe/GitHub webhooks) so the receiving endpoint can verify a
// request genuinely came from Kontora — returned to the caller in full
// only once, at creation (see webhook.service.ts's redaction on read).
model Webhook {
  id          String   @id @default(uuid())
  companyId   String
  url         String
  description String?
  secret      String
  isActive    Boolean  @default(true)
  events      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([companyId])
  @@map("webhooks")
}

// One row per delivery attempt (both real events and the "test webhook"
// button) — lets the settings UI show whether a webhook is actually
// working, not just that it's configured.
model WebhookDelivery {
  id           String   @id @default(uuid())
  webhookId    String
  event        String
  payload      Json
  statusCode   Int?
  success      Boolean
  errorMessage String?
  durationMs   Int?
  createdAt    DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

// Append-only audit trail of tenant-scoped mutations (invoice.created,
// team.role_changed, ...). Written by services after a successful write,
// never by controllers directly, so no mutation path can skip it.
model ActivityLog {
  id         String   @id @default(uuid())
  companyId  String
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@map("activity_logs")
}
