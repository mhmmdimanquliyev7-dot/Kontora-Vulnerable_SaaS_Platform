// Kontora — Prisma schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  // Lets the generated client's own internal imports (and our seed script,
  // which runs via Node's native TS support rather than tsc) resolve
  // directly without a compile step. tsc still compiles this fine when
  // building the db package for the api's production image.
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Role is per-membership, not on User. A person can belong to more than one
// Company (e.g. an accountant who contracts for two clients), and their
// permissions must never leak from one tenant into another — so the role
// lives on TeamMembership, scoped to a single (userId, companyId) pair.
enum Role {
  OWNER
  ACCOUNTANT
  MEMBER
  CLIENT_GUEST
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships TeamMembership[]
  clients     Client[]
  invoices    Invoice[]
  expenses    Expense[]
  sessions    Session[]

  @@map("companies")
}

// A person's global identity. Holds credentials only — no role, no company
// reference. All tenant-scoped permissions live on TeamMembership.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     TeamMembership[]
  sessions        Session[]
  createdInvoices Invoice[]        @relation("InvoiceCreatedBy")
  createdExpenses Expense[]        @relation("ExpenseCreatedBy")

  @@map("users")
}

// Links a User to a Company with a role scoped to that company.
// When role = CLIENT_GUEST, clientId identifies the single Client record
// this guest is allowed to see (enforced in the service layer, not just here).
model TeamMembership {
  id        String   @id @default(uuid())
  role      Role
  userId    String
  companyId String
  clientId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([clientId])
  @@map("team_memberships")
}

// A Company's customer — who invoices are billed to. Distinct from the
// CLIENT_GUEST *User* who may be granted portal access to view them.
model Client {
  id             String   @id @default(uuid())
  companyId      String
  name           String
  email          String?
  phone          String?
  billingAddress String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  guestMembers TeamMembership[]

  @@index([companyId])
  @@map("clients")
}

model Invoice {
  id          String        @id @default(uuid())
  companyId   String
  clientId    String
  createdById String?
  number      String
  status      InvoiceStatus @default(DRAFT)
  issueDate   DateTime
  dueDate     DateTime
  currency    String        @default("USD")
  subtotal    Decimal       @db.Decimal(12, 2)
  tax         Decimal       @db.Decimal(12, 2) @default(0)
  total       Decimal       @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     InvoiceItem[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([clientId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(12, 2) @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  position    Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Expense {
  id          String   @id @default(uuid())
  companyId   String
  createdById String?
  category    String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@map("expenses")
}

// One row per refresh token = one logged-in session, scoped to a single
// company context. Access tokens are short-lived JWTs derived from a
// Session and are never stored server-side.
model Session {
  id               String    @id @default(uuid())
  userId           String
  companyId        String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
