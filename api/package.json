{
  "name": "@kontora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kontora API — Express + TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kontora/db": "*",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "marked": "18.0.6",
    "mongoose": "9.7.4",
    "morgan": "1.11.0",
    "multer": "2.2.0",
    "nodemailer": "9.0.3",
    "pdfkit": "0.19.1",
    "rate-limit-redis": "5.0.0",
    "sanitize-html": "2.17.6",
    "sharp": "0.35.3",
    "slugify": "1.6.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/multer": "2.2.0",
    "@types/node": "26.1.1",
    "@types/nodemailer": "8.0.1",
    "@types/pdfkit": "0.17.6",
    "@types/sanitize-html": "2.16.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.5",
    "tsc-alias": "1.9.0",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0"
  }
}
