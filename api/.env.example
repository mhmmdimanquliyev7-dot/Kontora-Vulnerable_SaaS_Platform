NODE_ENV=development
PORT=4000

# Points at the "postgres" docker-compose service; use localhost:5433 when running the API outside Docker
# (5433, not 5432 — see root .env.example for why).
DATABASE_URL="postgresql://kontora:kontora_dev_password@localhost:5433/kontora"

# Points at the "redis" docker-compose service; use localhost when running the API outside Docker.
REDIS_URL="redis://localhost:6379"

CORS_ORIGIN="http://localhost:3000"

# Generate your own with: openssl rand -hex 32  (or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# Never reuse this example value outside local dev.
JWT_SECRET="replace-with-a-random-64-char-hex-string-min-32-chars-required"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_TOKEN_TTL_MINUTES=5
