NODE_ENV=development
PORT=4000

# Points at the "postgres" docker-compose service; use localhost when running the API outside Docker.
DATABASE_URL="postgresql://kontora:kontora_dev_password@localhost:5432/kontora?schema=public"

# Points at the "redis" docker-compose service; use localhost when running the API outside Docker.
REDIS_URL="redis://localhost:6379"

CORS_ORIGIN="http://localhost:3000"
