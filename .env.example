# Root-level variables consumed by docker-compose.yml.
# Copy to .env and adjust as needed: cp .env.example .env
# Individual services also have their own .env.example (frontend/, api/, db/)
# for running outside Docker.

POSTGRES_USER=kontora
POSTGRES_PASSWORD=kontora_dev_password
POSTGRES_DB=kontora
# Uses 5433 on the host to avoid colliding with a locally-installed Postgres
# on the default 5432 port. Change if 5433 is also taken. If `prisma
# migrate`/`db seed` run on the host still fail to authenticate no matter
# what's on this port, see the README troubleshooting section — use
# `npm run db:migrate:docker` / `db:seed:docker` instead.
POSTGRES_PORT=5433

REDIS_PORT=6379

API_PORT=4000
FRONTEND_PORT=3000

NEXT_PUBLIC_API_URL=http://localhost:4000

# Generate your own with: openssl rand -hex 32
JWT_SECRET="replace-with-a-random-64-char-hex-string-min-32-chars-required"
