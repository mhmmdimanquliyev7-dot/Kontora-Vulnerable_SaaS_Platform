# Root-level variables consumed by docker-compose.yml.
# Copy to .env and adjust as needed: cp .env.example .env
# Individual services also have their own .env.example (frontend/, api/, db/)
# for running outside Docker.

POSTGRES_USER=kontora
POSTGRES_PASSWORD=kontora_dev_password
POSTGRES_DB=kontora
# Uses 5433 on the host to avoid colliding with a locally-installed Postgres
# on the default 5432 port. Change if 5433 is also taken. If `prisma
# migrate`/`db seed` run on the host still fail to authenticate no matter
# what's on this port, see the README troubleshooting section — use
# `npm run db:migrate:docker` / `db:seed:docker` instead.
POSTGRES_PORT=5433

REDIS_PORT=6379

API_PORT=4000
FRONTEND_PORT=3000

NEXT_PUBLIC_API_URL=http://localhost:4000

# Generate your own with: openssl rand -hex 32
JWT_SECRET="replace-with-a-random-64-char-hex-string-min-32-chars-required"

# MongoDB — backs invoice comments only (Postgres remains the system of
# record for everything else). Root credentials are fine for local dev;
# a real deployment would scope a dedicated app user + database.
MONGO_USER=kontora
MONGO_PASSWORD=kontora_dev_password
MONGO_PORT=27017

# MailHog — catches password-reset emails in dev instead of sending them
# anywhere real. Web UI (read sent mail) at http://localhost:8025.
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# report-service (PHP) and export-worker (Java) are internal-only in the
# sense that nothing besides the API is meant to call them — but their ports
# are still published here (like Postgres/Redis) for local-dev convenience
# (Option B in the README) and ad-hoc debugging. A real deployment would
# drop these port mappings entirely and rely on the compose network alone.
REPORT_SERVICE_PORT=8090
EXPORT_WORKER_PORT=8091
# Only used once, when Postgres first initializes report-service's
# least-privilege read-only role (db/init/01-report-service-role.sh).
REPORT_SERVICE_DB_PASSWORD=report_service_dev_password

# Shared secret every call between the API and the two satellite services
# must carry (X-Internal-Api-Key header) — network isolation is one layer,
# this is the other. Generate your own with: openssl rand -hex 32
INTERNAL_API_KEY="replace-with-a-random-64-char-hex-string-min-32-chars-required"

# "Kontora ID" — the self-hosted mock OAuth 2.0 provider
# (services/oauth-provider). Unlike report-service/export-worker this one MUST
# be reachable from the browser: an authorization-code flow redirects the
# user's actual browser to its /authorize page.
OAUTH_PROVIDER_PORT=9000
# The client secret the API authenticates with at the /token endpoint. Both
# the api and oauth-provider services read this same value.
# Generate your own with: openssl rand -hex 32
OAUTH_CLIENT_SECRET="replace-with-a-random-64-char-hex-string-min-32-chars-required"
# Browser-facing issuer URL, and the exact redirect_uri registered for the
# client. OAUTH_REDIRECT_URIS is an exact-match allowlist (comma-separated) —
# the provider refuses to redirect anywhere not listed here.
OAUTH_ISSUER_PUBLIC_URL=http://localhost:9000
OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/oauth/callback
OAUTH_REDIRECT_URIS=http://localhost:4000/api/auth/oauth/callback
