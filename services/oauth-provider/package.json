{
  "name": "@kontora/oauth-provider",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kontora ID — a self-contained mock OAuth 2.0 authorization server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "5.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "tsc-alias": "1.9.0",
    "tsx": "4.23.0",
    "typescript": "6.0.3"
  }
}
