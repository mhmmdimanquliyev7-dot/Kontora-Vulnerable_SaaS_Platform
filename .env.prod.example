# Production-style variables, consumed together with docker-compose.yml +
# docker-compose.prod.yml. Copy to .env.prod and fill in real values:
#   cp .env.prod.example .env.prod
# Then run:
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# --env-file replaces the implicit .env load entirely (dev's .env is never
# read for this invocation), so this file is the single source of truth for
# a production run — see DEPLOY.md for the full walkthrough, including
# adding real HTTPS in front of nginx.
#
# Every value below is a placeholder. Generate fresh secrets — never reuse
# the ones in .env.example, which are committed and public.

POSTGRES_USER=kontora
POSTGRES_PASSWORD="replace-with-a-strong-random-password"
POSTGRES_DB=kontora
# No POSTGRES_PORT here: docker-compose.prod.yml removes the host port
# mapping entirely — Postgres is reachable only from other containers on
# the compose network, never from the host or the internet.

# MongoDB — backs invoice comments only (Postgres remains the system of
# record for everything else). Same "no host port" note as Postgres above;
# a real deployment should also scope a dedicated app user + database
# instead of root credentials.
MONGO_USER=kontora
MONGO_PASSWORD="replace-with-a-strong-random-password"

# Only used once, when Postgres first initializes report-service's
# least-privilege read-only role (db/init/01-report-service-role.sh).
REPORT_SERVICE_DB_PASSWORD="replace-with-a-strong-random-password"

# Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-random-64-char-hex-string-min-32-chars-required"

# Shared secret every call between the API and the two satellite services
# (report-service, export-worker) must carry. Generate with:
#   openssl rand -hex 32
INTERNAL_API_KEY="replace-with-a-random-64-char-hex-string-min-32-chars-required"

# The public origin users actually load the app from — the API's CORS
# middleware only matters for cross-origin requests (the browser calls it
# same-origin through nginx in the normal case), but must still match
# exactly. Use your real domain once you have one (see DEPLOY.md); for a
# local dry-run of this compose overlay, http://localhost:<NGINX_PORT>.
CORS_ORIGIN=https://kontora.example.com

# The single port nginx publishes to the host — everything else (postgres,
# redis, mongo, report-service, export-worker, api, frontend) is reachable
# only over the internal compose network. 80 for plain HTTP; once real TLS
# is in front (Caddy, or nginx+certbot — see DEPLOY.md), this is what that
# layer forwards to.
NGINX_PORT=80

# NEXT_PUBLIC_API_URL is intentionally NOT configurable here: it's fixed to
# an empty string in docker-compose.prod.yml's build args on purpose, so
# the frontend always calls the API at the same origin the page loaded
# from (via nginx) rather than a hard-coded host:port. Setting it here
# would have no effect.
